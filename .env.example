# Neon PostgreSQL connection string
# neon.tech에서 프로젝트 생성 후 "Connection string" 복사
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth secret (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET="your_better_auth_secret_here"

# App URL (로컬: http://localhost:3000 / 배포: https://your-domain.vercel.app)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 초기 관리자 계정 (db:seed 실행 시 사용)
ADMIN_EMAIL="admin@wesing.kr"
ADMIN_PASSWORD="your_strong_password_here"
