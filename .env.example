# Database - SQLite (local dev) or PostgreSQL (production)
DATABASE_URL="file:./dev.db"

# For Vercel/production with PostgreSQL (e.g., Neon, Supabase):
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Admin password for the management dashboard
ADMIN_PASSWORD="your_strong_password_here"

# JWT secret for session tokens (generate with: openssl rand -base64 32)
JWT_SECRET="your_jwt_secret_here"
